{
  "name": "yulove",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "test:worker-docker": "pnpm --filter @yulove/worker test:docker",
    "seed:super-admins": "pnpm --filter @yulove/scripts seed:super-admins",
    "smoke:worker": "pnpm --filter @yulove/scripts smoke:worker",
    "try:transcribe": "pnpm --filter @yulove/scripts try:transcribe",
    "seed:dev-questions": "pnpm --filter @yulove/scripts seed:dev-questions",
    "e2e:pipeline": "pnpm --filter @yulove/scripts e2e:pipeline",
    "web:env": "pnpm --filter @yulove/scripts web:env",
    "web:vercel-env": "pnpm --filter @yulove/scripts web:vercel-env",
    "backfill:answers-exam-index": "pnpm --filter @yulove/scripts backfill:answers-exam-index",
    "ecr:lifecycle": "pnpm --filter @yulove/scripts ecr:lifecycle",
    "logs:retention": "pnpm --filter @yulove/scripts logs:retention",
    "compare:transcriptions": "pnpm --filter @yulove/scripts compare:transcriptions",
    "cleanup:dev-data": "pnpm --filter @yulove/scripts cleanup:dev-data",
    "mark:dev-data": "pnpm --filter @yulove/scripts mark:dev-data"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
